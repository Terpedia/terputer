# Optional Terpedia chat proxy. Vite embeds these values during the Codespace build.
VITE_TERPEDIA_CHAT_URL=/api/v1/chat/completions
VITE_TERPEDIA_MODEL=terpedia/research

# Server-side Knowledge API credential (do not prefix with VITE_).
TERPEDIA_KNOWLEDGE_API_KEY=
TERPEDIA_KB_API_URL=https://terpedia-knowledge-nanrsdlaoa-uc.a.run.app
PORT=4173

# Required for the in-app research agent and its MCP-backed tool calls.
TERPUTER_OPENROUTER_API_KEY=
TERPUTER_AGENT_MODEL=openai/gpt-4.1-mini
TERPUTER_WORKER_URL=https://terputer.terpedia.com
TERPUTER_WORKER_TOKEN=
TERPUTER_BIGQUERY_API_URL=
TERPUTER_GENE_EFFECTS_ENABLED=false
TERPUTER_BIGQUERY_TOOL_KEY=
